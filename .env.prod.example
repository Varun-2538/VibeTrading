# Copy to .env on the VM and fill in. Never commit the real .env.

# LLM - any OpenAI-compatible endpoint. Defaults target Groq's free tier;
# override BASE_URL/MODEL to point at another provider.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Hostname Caddy requests a TLS certificate for. Its A record must already
# point at this VM before the stack starts, or issuance fails.
API_DOMAIN=api.vibetrading.club

# Origin allowed by CORS - the Vercel frontend.
FRONTEND_URL=https://vibetrading.club

# Database
TIMESCALE_USER=tradesmart
TIMESCALE_PASSWORD=

# Signs the session tokens issued after a wallet proves itself. Generate with
#   openssl rand -hex 32
# Anyone who learns this can mint a session for any wallet address, so treat it
# like a database password. Changing it signs everyone out.
JWT_SECRET=
