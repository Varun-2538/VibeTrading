# Copy to .env on the VM and fill in. Never commit the real .env.

# Cerebras API (models available on this key: gpt-oss-120b, zai-glm-4.7, gemma-4-31b)
CEREBRAS_API_KEY=

# Hostname Caddy requests a TLS certificate for. Its A record must already
# point at this VM before the stack starts, or issuance fails.
API_DOMAIN=api.vibetrading.club

# Origin allowed by CORS - the Vercel frontend.
FRONTEND_URL=https://vibetrading.club

# Database
TIMESCALE_USER=tradesmart
TIMESCALE_PASSWORD=
